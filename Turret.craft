name: Turret
maxSize: 250
minSize: 1
allowedBlocks:
    - '#basicmaterials'
    - '#armor'
    - '#chests'
    - '#smelter'

forbiddenBlocks:
    - piston_head
    - sticky_piston
    - obsidian
    - "#anvil"
    - hopper

canFly: false
allowVerticalMovement: false
requireWaterContact: false
rotateAtMidpoint: true
canCruise: false
cruiseSpeed: 1
cruiseSkipBlocks: 1
maxHeightLimit: 321
maxHeightAboveGround: -1
collisionExplosion: 0.0
fuelBurnRate: 0.0
explodeOnCrash: 0.5
sinkSpeed: 8.0
blockRemoteRotate: false
overallSinkPercent: 90.0
detectionMultiplier: 10.0
underwaterDetectionMultiplier: 3.0
smokeOnSink: 1
keepMovingOnSink: true
speed: 15.0
tryNudge: false
sinkPercent: 95.0
flyblocks:
    "#basicmaterials": # wool for lift, limited to encourage agility
        - 1.0
        - 100.0
passthroughBlocks:
    - "#passthrough"

maxCannons:
    turret-cannon: N4
